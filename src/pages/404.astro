---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="ページが見つかりません" currentPath="/404/">
  <section class="not-found">
    <div class="container not-found__inner">
      <span class="not-found__ball" aria-hidden="true"><Icon name="baseball" size={64} /></span>
      <p>404</p>
      <h1>ページが見つかりません。</h1>
      <p>移動したページ、または存在しないアドレスの可能性があります。</p>
      <div class="not-found__actions">
        <a class="button button--blue" href="/">ホームへ戻る <Icon name="arrow" size={19} /></a>
        <a class="button button--outline" href="/facilities/">施設案内を見る</a>
      </div>
    </div>
  </section>
</BaseLayout>
