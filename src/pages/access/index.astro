---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import PhotoCredit from '../../components/PhotoCredit.astro';
import { content } from '../../data/site';
---
<BaseLayout
  title="アクセス"
  description="JR市坪駅、松山市駅からのバス、松山IC・松山空港から車で松山中央公園へ向かう方法と駐車時の注意点。"
  currentPath="/access/"
>
  <PageHero
    eyebrow="アクセス"
    title="JR市坪駅から、歩いて約5分。"
    lead="駅のホームから球場の屋根が見える近さ。通常日も大型イベントの日も、まず検討しやすいのはJRです。"
    image="/images/ichitsubo-station-stadium-1800.webp"
    imageMobile="/images/ichitsubo-station-stadium-960.webp"
    alt="JR市坪駅のホームと坊っちゃんスタジアム"
    current="アクセス"
  />

  <section class="section section--paper access-intro">
    <div class="container access-intro__grid">
      <SectionHeading
        eyebrow="所在地"
        title="松山市南部、市坪駅に隣接するスポーツパーク。"
        text="坊っちゃんスタジアムを中心に施設が広く分布しています。目的の施設を決めてから入口と移動方法を選ぶと、園内を歩きやすくなります。"
      />
      <div class="address-card">
        <Icon name="map-pin" size={34} />
        <div>
          <span>住所</span>
          <strong>{content.site.address}</strong>
          <a href="https://www.google.com/maps/search/?api=1&query=33.8093572%2C132.7459764" target="_blank" rel="noreferrer">地図アプリで開く <Icon name="arrow" size={17} /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--cream access-methods">
    <div class="container">
      <SectionHeading
        eyebrow="行き方を選ぶ"
        title="電車、バス、車の三つの方法。"
        text="所要時間は交通状況や列車・バスの運行により変わります。イベント日は時間に余裕を持って移動してください。"
      />
      <div class="access-method-grid">
        {content.access.map((method, methodIndex) => (
          <article class:list={['access-method', { 'access-method--recommended': method.id === 'train' }]} id={method.id}>
            {method.id === 'train' && <span class="access-method__badge">おすすめ</span>}
            <span class="access-method__icon"><Icon name={method.icon} size={34} /></span>
            <p class="mini-label">方法 {String(methodIndex + 1).padStart(2, '0')}</p>
            <h2>{method.title}</h2>
            <p>{method.lead}</p>
            <ol>
              {method.steps.map((step, index) => <li><span>{index + 1}</span>{step}</li>)}
            </ol>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--paper station-guide">
    <div class="container station-guide__grid">
      <figure class="station-guide__media">
        <img src="/images/ichitsubo-station-stadium-1800.webp" alt="市坪駅と坊っちゃんスタジアムの位置関係" width="1800" height="1200" loading="lazy" />
        <figcaption>市坪駅を出ると、球場の大屋根が移動の目印になります。</figcaption>
        <PhotoCredit label="CT-May／クリエイティブ・コモンズ・ゼロ" />
      </figure>
      <div class="station-guide__copy">
        <SectionHeading
          eyebrow="JR市坪駅から"
          title="球場の屋根を目印に、園内へ。"
          text="市坪駅には「野球（の・ボール）駅」という愛称があります。駅周辺から坊っちゃんスタジアム、資料館へは短い徒歩移動です。"
        />
        <ol class="direction-list">
          <li><span><Icon name="train" size={22} /></span><div><strong>市坪駅で下車</strong><p>ホームから球場の方向を確認します。</p></div></li>
          <li><span><Icon name="walk" size={22} /></span><div><strong>駅前から園内方向へ</strong><p>歩行者の案内と球場の大屋根を目印に進みます。</p></div></li>
          <li><span><Icon name="baseball" size={22} /></span><div><strong>坊っちゃんスタジアム正面へ</strong><p>資料館は球場正面側にあります。</p></div></li>
        </ol>
      </div>
    </div>
  </section>

  <section class="map-section">
    <div class="container map-section__grid">
      <div class="map-section__copy">
        <p class="mini-label">位置を確認</p>
        <h2>松山中央公園</h2>
        <p>{content.site.address}</p>
        <dl>
          <div><dt>緯度</dt><dd>{content.site.latitude}</dd></div>
          <div><dt>経度</dt><dd>{content.site.longitude}</dd></div>
          <div><dt>公園面積</dt><dd>{content.site.area}</dd></div>
        </dl>
        <a class="button button--gold" href="https://www.google.com/maps/search/?api=1&query=33.8093572%2C132.7459764" target="_blank" rel="noreferrer">大きな地図で開く <Icon name="arrow" size={18} /></a>
      </div>
      <div class="map-frame">
        <iframe
          title="松山中央公園の地図"
          src="https://www.google.com/maps?q=33.8093572,132.7459764&hl=ja&z=15&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <section class="section section--cream parking-section">
    <div class="container parking-section__grid">
      <div>
        <SectionHeading
          eyebrow="駐車場とイベント日"
          title="車の日は、時間と混雑を見込む。"
          text="駐車場は通常8:00から21:30まで利用できますが、大型催事では開放範囲、料金、入退場動線が変わることがあります。"
        />
      </div>
      <div class="notice-stack">
        <article><Icon name="clock" size={25} /><div><h3>駐車場利用時間</h3><p>通常8:00–21:30。施設や催事の運用により変更される場合があります。</p></div></article>
        <article><Icon name="ticket" size={25} /><div><h3>試合・大型催事</h3><p>満車や周辺道路の混雑が起こりやすいため、JRや臨時輸送を優先すると移動が分かりやすくなります。</p></div></article>
        <article><Icon name="route" size={25} /><div><h3>園内道路</h3><p>施設利用者の動線を優先し、通り抜けを目的とした走行は避けてください。</p></div></article>
      </div>
    </div>
  </section>

  <section class="contact-band">
    <div class="container contact-band__inner">
      <span class="contact-band__icon"><Icon name="phone" size={29} /></span>
      <div><p>松山中央公園管理事務所</p><a href={`tel:${content.site.phone.replaceAll('-', '')}`}>{content.site.phone}</a></div>
      <p>施設利用、開場条件、催事当日の運用について確認する際の連絡先です。</p>
    </div>
  </section>
</BaseLayout>
