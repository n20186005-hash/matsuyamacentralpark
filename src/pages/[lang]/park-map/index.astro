---
import ParkMapPage from '../../../components/pages/ParkMapPage.astro';
import type { Locale } from '../../../i18n/config';

export function getStaticPaths() {
  return [
    { params: { lang: 'zh-Hant' } },
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params;
const locale = lang as Locale;
---

<ParkMapPage locale={locale} />
