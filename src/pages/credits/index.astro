---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { content } from '../../data/site';
---
<BaseLayout
  title="写真クレジット"
  description="松山中央公園ガイドで使用している坊っちゃんスタジアム、アクアパレットまつやま、愛媛県武道館などの写真クレジット。"
  currentPath="/credits/"
>
  <section class="plain-hero">
    <div class="container plain-hero__inner">
      <nav class="breadcrumbs" aria-label="パンくずリスト"><a href="/">ホーム</a><Icon name="arrow" size={15} /><span aria-current="page">写真クレジット</span></nav>
      <p class="plain-hero__eyebrow">写真について</p>
      <h1>写真クレジット</h1>
      <p>サイト内の写真は、実在する松山中央公園の施設を写した素材を使用し、表示に合わせてリサイズ、トリミング、色調調整を行っています。</p>
    </div>
  </section>

  <section class="section section--paper credits-section">
    <div class="container">
      <SectionHeading
        eyebrow="使用素材"
        title="撮影者とライセンス。"
        text="各写真の原典、作者、利用条件を一覧にしています。"
      />
      <div class="credit-list">
        {content.credits.map((credit, index) => (
          <article class="credit-item">
            <span class="credit-item__number">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h2>{credit.file}</h2>
              <dl>
                <div><dt>作者・提供</dt><dd>{credit.author}</dd></div>
                <div><dt>ライセンス</dt><dd>{credit.license}</dd></div>
                <div><dt>使用箇所</dt><dd>{credit.usage}</dd></div>
              </dl>
              <a class="text-link" href={credit.source} target="_blank" rel="license noreferrer">原典を確認する <Icon name="arrow" size={18} /></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band cta-band--blue">
    <div class="container cta-band__inner">
      <div><p class="mini-label">園内案内へ戻る</p><h2>写真から、実際の景色へ。</h2><p>施設ごとの見どころと利用案内を確認できます。</p></div>
      <a class="button button--gold" href="/facilities/">施設案内を見る <Icon name="arrow" size={19} /></a>
    </div>
  </section>
</BaseLayout>
