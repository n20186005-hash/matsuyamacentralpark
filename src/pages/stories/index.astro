---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import PhotoCredit from '../../components/PhotoCredit.astro';
import { content } from '../../data/site';
const baseballRoute = content.routes[0]!;
---
<BaseLayout
  title="松山と野球の物語"
  description="正岡子規、野球王国・愛媛、近藤兵太郎と台湾、プロ野球オールスター。松山中央公園でたどる野球文化の物語。"
  currentPath="/stories/"
  image="/images/og.jpg"
>
  <PageHero
    eyebrow="松山と野球"
    title="球場を歩く前に、五つの物語を。"
    lead="文学の町で育ったベースボールの言葉、地域が守った野球文化、海を越えた指導者の足跡。知るほどに、球場の風景が深くなります。"
    image="/images/botchan-stadium-night-2200.webp"
    alt="坊っちゃんスタジアムの夜景と照明に浮かぶグラウンド"
    current="野球の物語"
    tone="night"
  />

  <section class="section section--paper story-opening">
    <div class="container story-opening__grid">
      <SectionHeading
        eyebrow="野球文化の入口"
        title="松山では、野球が文学と地域史につながっている。"
        text="坊っちゃんスタジアムは試合を行うだけの場所ではありません。園内の名前、記念碑、資料館の展示をたどると、明治から現代へ続く松山の野球文化が見えてきます。"
      />
      <div class="story-opening__numbers">
        <div><strong>5</strong><span>園内でたどる物語</span></div>
        <div><strong>3</strong><span>オールスター開催回数</span></div>
        <div><strong>無料</strong><span>資料館の入館料</span></div>
      </div>
    </div>
  </section>

  <section class="section section--cream story-timeline" aria-label="松山と野球の五つの物語">
    <div class="container">
      {content.stories.map((story, index) => (
        <article class="story-chapter" id={story.id}>
          <div class="story-chapter__marker">
            <span>{String(index + 1).padStart(2, '0')}</span>
          </div>
          <div class="story-chapter__copy">
            <p>{story.eyebrow}</p>
            <h2>{story.title}</h2>
            <p class="story-chapter__text">{story.text}</p>
            {story.id === 'shiki' && (
              <div class="story-note">
                <Icon name="baseball" size={23} />
                <p><strong>園内で探すもの</strong><br />JR市坪駅の近くには、正岡子規の野球殿堂入りを記念する碑があります。</p>
              </div>
            )}
            {story.id === 'name' && (
              <div class="story-note">
                <Icon name="museum" size={23} />
                <p><strong>名前の連なり</strong><br />「坊っちゃん」「マドンナ」「の・ボール」という名称に、文学の町らしい遊び心が表れています。</p>
              </div>
            )}
            {story.id === 'kondo' && (
              <div class="story-note">
                <Icon name="route" size={23} />
                <p><strong>海を越える地域史</strong><br />松山と台湾を結ぶ野球史は、この公園を海外から訪れる人にも特別な場所にしています。</p>
              </div>
            )}
          </div>
          <aside class="story-chapter__aside" aria-hidden="true">
            <Icon name={index === 3 ? 'route' : index === 4 ? 'ticket' : 'baseball'} size={44} />
          </aside>
        </article>
      ))}
    </div>
  </section>

  <section class="museum-feature">
    <figure class="museum-feature__media">
      <img src="/images/botchan-stadium-night-2200.webp" alt="坊っちゃんスタジアムのグラウンドと青い観客席" width="2200" height="1042" loading="lazy" />
      <PhotoCredit label="Carpawa／パブリックドメイン" />
    </figure>
    <div class="museum-feature__panel">
      <p class="mini-label">物語の続きを館内で</p>
      <h2>の・ボールミュージアム</h2>
      <p>坊っちゃんスタジアム正面にある無料の野球歴史資料館。正岡子規、愛媛の高校野球、近藤兵太郎、プロ野球、秋季キャンプなど、多層的な展示を一つの流れで見られます。</p>
      <dl class="museum-feature__facts">
        <div><dt>開館</dt><dd>土・日・祝日</dd></div>
        <div><dt>時間</dt><dd>9:00–17:00</dd></div>
        <div><dt>最終入館</dt><dd>16:30</dd></div>
        <div><dt>入館料</dt><dd>無料</dd></div>
      </dl>
      <a class="button button--gold" href="/facilities/#baseball-museum">施設案内を見る <Icon name="arrow" size={19} /></a>
    </div>
  </section>

  <section class="section section--paper story-walk">
    <div class="container story-walk__grid">
      <div>
        <SectionHeading
          eyebrow="現地でたどる"
          title="五つの場所を、約90分で。"
          text="市坪駅の記念碑から球場正面、資料館、マドンナスタジアム、武道館へ。物語と建築を一つの散策にまとめられます。"
        />
        <ol class="vertical-steps">
          {baseballRoute.stops.map((stop, index) => (
            <li><span>{index + 1}</span><strong>{stop}</strong></li>
          ))}
        </ol>
        <a class="button button--blue" href="/visit/#baseball-route">野球文化コースを見る <Icon name="arrow" size={19} /></a>
      </div>
      <figure>
        <img src="/images/ichitsubo-station-stadium-960.webp" alt="市坪駅のホームと坊っちゃんスタジアム" width="960" height="640" loading="lazy" />
        <figcaption>市坪駅から始まる野球文化散策</figcaption>
        <PhotoCredit label="CT-May／クリエイティブ・コモンズ・ゼロ" />
      </figure>
    </div>
  </section>

  <section class="cta-band cta-band--blue">
    <div class="container cta-band__inner">
      <div>
        <p class="mini-label">公園を歩く</p>
        <h2>物語を知ったら、実際の景色へ。</h2>
        <p>テーマ別のモデルコースから、訪問時間と巡る順番を決められます。</p>
      </div>
      <a class="button button--gold" href="/visit/">モデルコースを選ぶ <Icon name="arrow" size={19} /></a>
    </div>
  </section>
</BaseLayout>
