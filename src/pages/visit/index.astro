---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import RoutePlanner from '../../components/RoutePlanner.astro';
import RouteCard from '../../components/RouteCard.astro';
import PhotoCredit from '../../components/PhotoCredit.astro';
import { content } from '../../data/site';
---
<BaseLayout
  title="おすすめの過ごし方"
  description="野球文化、親子、建築・写真、ジョギング。松山中央公園を無理なく巡る四つのモデルコースと訪問のヒント。"
  currentPath="/visit/"
>
  <PageHero
    eyebrow="過ごし方"
    title="目的が決まると、公園はもっと歩きやすい。"
    lead="約90分の野球文化散策から、プールを中心にした親子半日プランまで。興味と時間に合わせて順路を選べます。"
    image="/images/madonna-stadium-panorama-2000.webp"
    alt="マドンナスタジアムのグラウンドと観客席のパノラマ"
    current="過ごし方"
  />

  <section class="section section--paper planner-page-section">
    <div class="container">
      <RoutePlanner
        heading="興味から、今日のコースを決める"
        text="四つのテーマから一つを選ぶと、所要時間と距離の目安を表示します。"
      />
    </div>
  </section>

  <section class="section section--cream route-list-section">
    <div class="container">
      <SectionHeading
        eyebrow="四つのモデルコース"
        title="短時間でも、半日でも。"
        text="各コースは園内を回遊しやすい順番で構成しています。試合や催事がある日は、立入範囲や人の流れに合わせて調整してください。"
      />
      <div class="route-grid">
        {content.routes.map((route, index) => <RouteCard route={route} index={index} />)}
      </div>
    </div>
  </section>

  <section class="section section--paper visit-scenes" id="photo-spots">
    <div class="container">
      <SectionHeading
        eyebrow="写真に残したい風景"
        title="スポーツ施設の素材とスケールを撮る。"
        text="花や庭園ではなく、大屋根、木組み、石垣、駅と球場の距離感が、この公園らしい被写体です。"
      />
      <div class="scene-grid">
        <figure class="scene-card scene-card--wide">
          <img src="/images/hero-1800.webp" alt="坊っちゃんスタジアムの大きな円形屋根" width="1800" height="1200" loading="lazy" />
          <figcaption><span>坊っちゃんスタジアム</span><strong>空へ張り出す大屋根</strong><small>正面低層部から見上げる構図</small></figcaption>
          <PhotoCredit label="松山市役所／クリエイティブ・コモンズ表示4.0" />
        </figure>
        <figure class="scene-card">
          <img src="/images/ehime-budokan-960.webp" alt="瓦屋根と木組みが印象的な愛媛県武道館" width="960" height="640" loading="lazy" />
          <figcaption><span>愛媛県武道館</span><strong>瓦、木、石の重なり</strong><small>斜めから建物の奥行きを出す</small></figcaption>
          <PhotoCredit label="Carpawa／パブリックドメイン" />
        </figure>
        <figure class="scene-card">
          <img src="/images/ichitsubo-station-stadium-960.webp" alt="市坪駅と坊っちゃんスタジアムが並ぶ風景" width="960" height="640" loading="lazy" />
          <figcaption><span>JR市坪駅</span><strong>駅の向こうに球場</strong><small>移動とスポーツが隣接する景色</small></figcaption>
          <PhotoCredit label="CT-May／クリエイティブ・コモンズ・ゼロ" />
        </figure>
      </div>
    </div>
  </section>

  <section class="section section--cream visit-tips-section">
    <div class="container">
      <SectionHeading
        eyebrow="訪問のヒント"
        title="現地で迷わないための四つのポイント。"
      />
      <div class="tip-grid">
        {content.visitTips.map((tip, index) => (
          <article class="tip-card">
            <span class="tip-card__number">{String(index + 1).padStart(2, '0')}</span>
            <Icon name={tip.icon} size={30} />
            <h3>{tip.title}</h3>
            <p>{tip.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="day-plan">
    <div class="container day-plan__grid">
      <div class="day-plan__copy">
        <p class="mini-label">半日の組み立て例</p>
        <h2>午前は水辺、午後は球場へ。</h2>
        <p>家族で訪れる日は、体力を使うプールを先にして、休憩後に球場外観と資料館へ移動すると無理がありません。</p>
        <ol>
          <li><time>09:30</time><span><strong>アクアパレット</strong><small>泳ぐ・水遊び</small></span></li>
          <li><time>11:30</time><span><strong>園内で休憩</strong><small>着替えと移動</small></span></li>
          <li><time>12:15</time><span><strong>坊っちゃんスタジアム</strong><small>外観と大屋根</small></span></li>
          <li><time>12:40</time><span><strong>の・ボールミュージアム</strong><small>土・日・祝日に見学</small></span></li>
        </ol>
      </div>
      <figure class="day-plan__media">
        <img src="/images/aqua-palette-1800.webp" alt="アクアパレットまつやまの建物とウォータースライダー" width="1800" height="1200" loading="lazy" />
        <PhotoCredit label="CT-May／クリエイティブ・コモンズ・ゼロ" />
      </figure>
    </div>
  </section>

  <section class="cta-band cta-band--blue">
    <div class="container cta-band__inner">
      <div>
        <p class="mini-label">出発の準備</p>
        <h2>コースを選んだら、交通を確認する。</h2>
        <p>JR市坪駅、バス停、車での目安、駐車時の注意点を一つのページにまとめています。</p>
      </div>
      <a class="button button--gold" href="/access/">アクセスを見る <Icon name="arrow" size={19} /></a>
    </div>
  </section>
</BaseLayout>
