---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FacilityCard from '../components/FacilityCard.astro';
import RoutePlanner from '../components/RoutePlanner.astro';
import PhotoCredit from '../components/PhotoCredit.astro';
import { content } from '../data/site';

const featuredFacilities = content.facilities.filter((facility) => facility.featured);
---
<BaseLayout title={content.site.name} currentPath="/" bodyClass="home-page">
  <section class="home-hero">
    <picture class="home-hero__media">
      <source media="(max-width: 680px)" srcset="/images/hero-mobile.webp" />
      <source media="(max-width: 1100px)" srcset="/images/hero-960.webp" />
      <img src="/images/hero-1800.webp" alt="青空の下に広がる坊っちゃんスタジアムの外観" width="1800" height="1200" fetchpriority="high" />
    </picture>
    <div class="home-hero__shade"></div>
    <div class="home-hero__curve" aria-hidden="true"></div>
    <div class="container home-hero__inner">
      <p class="home-hero__eyebrow"><span></span> 愛媛・松山のスポーツパーク</p>
      <h1>{content.site.name}</h1>
      <p class="home-hero__tagline">{content.site.tagline}</p>
      <p class="home-hero__lead">坊っちゃんスタジアムから始まる、松山の野球文化、建築、水泳、市民スポーツをめぐる一日。</p>
      <div class="home-hero__actions">
        <a class="button button--gold" href="/facilities/">施設を見つける <Icon name="arrow" size={19} /></a>
        <a class="button button--glass" href="/access/"><Icon name="train" size={19} /> 市坪駅からの行き方</a>
      </div>
      <div class="home-hero__note">
        <Icon name="map-pin" size={19} />
        <span>JR市坪駅から徒歩約5分</span>
      </div>
    </div>
    <PhotoCredit label="松山市役所／クリエイティブ・コモンズ表示4.0" />
  </section>

  <section class="score-strip" aria-label="基本情報">
    <div class="container score-strip__grid">
      {content.quickFacts.map((fact) => (
        <div class="score-item">
          <Icon name={fact.icon} size={25} />
          <div>
            <span>{fact.label}</span>
            <strong>{fact.value}</strong>
            <small>{fact.detail}</small>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section section--paper intro-section">
    <div class="container split-intro">
      <div class="split-intro__copy">
        <SectionHeading
          eyebrow="松山中央公園とは"
          title="ここは、普通の公園ではありません。"
          text="緑地を歩くだけの公園ではなく、野球場、プール、武道館、テニスコート、多目的競技場が一つにつながる総合スポーツパークです。"
        />
        <p>中心に立つのは、3万人を収容する坊っちゃんスタジアム。大きな屋根と青い観客席を目印に、正岡子規から現代へ続く野球文化、県産材を生かした武道館建築、家族で楽しめる水の施設へと歩みを広げられます。</p>
        <div class="intro-actions">
          <a class="text-link" href="/stories/">松山と野球の物語 <Icon name="arrow" size={18} /></a>
          <a class="text-link" href="/visit/">おすすめの過ごし方 <Icon name="arrow" size={18} /></a>
        </div>
      </div>
      <figure class="split-intro__visual">
        <img src="/images/ichitsubo-station-stadium-960.webp" alt="JR市坪駅と、その向こうに見える坊っちゃんスタジアム" width="960" height="640" loading="lazy" />
        <figcaption>
          <span>駅と球場が隣り合う風景</span>
          <small>JR市坪駅から園内へ徒歩約5分</small>
        </figcaption>
        <PhotoCredit label="CT-May／クリエイティブ・コモンズ・ゼロ" />
      </figure>
    </div>
  </section>

  <section class="section section--cream experiences-section">
    <div class="container">
      <SectionHeading
        eyebrow="楽しみ方"
        title="この場所で、何をする？"
        text="観戦だけではない四つの入口から、自分に合った松山中央公園の時間を見つけられます。"
        align="center"
      />
      <div class="experience-grid">
        {content.experiences.map((experience, index) => (
          <a class="experience-card" href={experience.href}>
            <span class="experience-card__number">{String(index + 1).padStart(2, '0')}</span>
            <span class="experience-card__icon"><Icon name={experience.icon} size={31} /></span>
            <h3>{experience.title}</h3>
            <p>{experience.text}</p>
            <span class="experience-card__link">詳しく見る <Icon name="arrow" size={18} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--paper facilities-preview">
    <div class="container">
      <div class="section-bar">
        <SectionHeading
          eyebrow="主要施設"
          title="四つの場所から巡り始める。"
          text="初めて訪れるなら、球場、資料館、プール、武道館を中心にすると、公園の個性がよく分かります。"
        />
        <a class="button button--outline" href="/facilities/">すべての施設 <Icon name="arrow" size={18} /></a>
      </div>
      <div class="facility-grid facility-grid--featured">
        {featuredFacilities.map((facility) => <FacilityCard facility={facility} />)}
      </div>
    </div>
  </section>

  <section class="story-feature">
    <picture class="story-feature__media">
      <source media="(max-width: 900px)" srcset="/images/botchan-stadium-night-1200.webp" />
      <img src="/images/botchan-stadium-night-2200.webp" alt="夜間照明に照らされた坊っちゃんスタジアムのグラウンド" width="2200" height="1042" loading="lazy" />
    </picture>
    <div class="story-feature__shade"></div>
    <div class="container story-feature__inner">
      <SectionHeading
        eyebrow="松山と野球"
        title="一つの球場に、百年以上の物語が集まる。"
        text="正岡子規が広めたベースボール、野球王国・愛媛、近藤兵太郎と台湾、三度のオールスター。園内を歩く前に知ると、見える風景が変わります。"
        light={true}
      />
      <div class="story-feature__list">
        {content.stories.slice(0, 4).map((story) => (
          <a href={`/stories/#${story.id}`}>
            <span>{story.eyebrow}</span>
            <strong>{story.title}</strong>
            <Icon name="arrow" size={19} />
          </a>
        ))}
      </div>
      <a class="button button--gold" href="/stories/">五つの物語を読む <Icon name="arrow" size={19} /></a>
    </div>
    <PhotoCredit label="Carpawa／パブリックドメイン" />
  </section>

  <section class="section section--cream planner-section">
    <div class="container">
      <RoutePlanner />
    </div>
  </section>

  <section class="section section--paper access-preview">
    <div class="container access-preview__grid">
      <div class="access-preview__media">
        <img src="/images/ichitsubo-station-stadium-1800.webp" alt="市坪駅ホームと坊っちゃんスタジアム" width="1800" height="1200" loading="lazy" />
        <div class="access-preview__badge">
          <Icon name="train" size={28} />
          <span><small>最寄り</small><strong>JR市坪駅</strong></span>
        </div>
      </div>
      <div class="access-preview__copy">
        <SectionHeading
          eyebrow="アクセス"
          title="駅を降りると、球場の屋根が見える。"
          text="JR松山駅から市坪駅まで約10分。駅から主要施設へは徒歩約5分です。大型イベントの日にも分かりやすい移動方法です。"
        />
        <ol class="access-preview__steps">
          <li><span>1</span><div><strong>JR松山駅</strong><small>予讃線で約10分</small></div></li>
          <li><span>2</span><div><strong>JR市坪駅</strong><small>「野球（の・ボール）駅」の愛称</small></div></li>
          <li><span>3</span><div><strong>松山中央公園</strong><small>駅から徒歩約5分</small></div></li>
        </ol>
        <a class="button button--blue" href="/access/">電車・バス・車の案内 <Icon name="arrow" size={19} /></a>
      </div>
    </div>
  </section>

  <section class="section section--cream faq-section">
    <div class="container faq-layout">
      <SectionHeading
        eyebrow="よくある質問"
        title="訪れる前に知っておきたいこと。"
        text="場所の違い、資料館の開館日、所要時間など、初めての訪問で迷いやすい点をまとめました。"
      />
      <div class="faq-list">
        {content.faqs.map((faq, index) => (
          <details open={index === 0}>
            <summary><span>{String(index + 1).padStart(2, '0')}</span>{faq.question}<Icon name="arrow" size={18} /></summary>
            <div><p>{faq.answer}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
