---
import Icon from './Icon.astro';
import { useTranslations } from '../i18n/ui';
import { localizePath } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  image: string;
  imageMobile?: string;
  alt: string;
  current: string;
  tone?: 'blue' | 'night';
  locale?: Locale;
}

const {
  eyebrow,
  title,
  lead,
  image,
  imageMobile,
  alt,
  current,
  tone = 'blue',
  locale = 'ja'
} = Astro.props;
const t = useTranslations(locale);
const heroClass = ['page-hero', `page-hero--${tone}`];
---
<section class:list={heroClass}>
  <picture class="page-hero__media">
    {imageMobile && <source media="(max-width: 680px)" srcset={imageMobile} />}
    <img src={image} alt={alt} width="1800" height="1200" fetchpriority="high" />
  </picture>
  <div class="page-hero__shade"></div>
  <div class="container page-hero__inner">
    <nav class="breadcrumbs" aria-label={t('breadcrumbs')}>
      <a href={localizePath('/', locale)}>{t('home')}</a>
      <Icon name="arrow" size={15} />
      <span aria-current="page">{current}</span>
    </nav>
    <p class="page-hero__eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="page-hero__lead">{lead}</p>
  </div>
</section>
