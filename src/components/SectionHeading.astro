---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  align?: 'left' | 'center';
  light?: boolean;
}
const { eyebrow, title, text, align = 'left', light = false } = Astro.props;
const headingClass = ['section-heading', `section-heading--${align}`, { 'section-heading--light': light }];
---
<header class:list={headingClass}> 
  {eyebrow && <p class="section-heading__eyebrow">{eyebrow}</p>}
  <h2>{title}</h2>
  {text && <p class="section-heading__text">{text}</p>}
</header>
