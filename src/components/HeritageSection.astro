---
import SectionHeading from './SectionHeading.astro';
import type { Locale } from '../i18n/config';
import { getContent } from '../i18n/content';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale?: Locale;
}
const { locale = 'ja' } = Astro.props;
const t = useTranslations(locale);
const content = getContent(locale);
---
<section class="section section--paper heritage-section" id="heritage" aria-labelledby="heritage-title">
  <div class="container">
    <SectionHeading eyebrow={t('heritage.eyebrow')} title={t('heritage.title')} text={t('heritage.text')} />
    <div class="heritage-grid">
      {content.heritage.map((item) => (
        <article class="heritage-card">
          <p class="heritage-card__eyebrow">{item.eyebrow}</p>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
