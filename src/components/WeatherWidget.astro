    '45': { day: 'Fog' }, '48': { day: 'Fog' },
    '51': { day: 'Drizzle' }, '53': { day: 'Drizzle' }, '55': { day: 'Drizzle' }, '57': { day: 'Drizzle' },
    '61': { day: 'Light rain' }, '63': { day: 'Rain' }, '65': { day: 'Heavy rain' },
    '71': { day: 'Snow' }, '73': { day: 'Snow' }, '75': { day: 'Snow' }, '77': { day: 'Snow' },
