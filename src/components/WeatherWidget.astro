const WX = locale === 'zh-Hant' ? zhHant : locale === 'en' ? en : ja;
---
<section class="section section--blue weather-section" id="weather" aria-labelledby="weather-title">
  <div class="container">
    <SectionHeading eyebrow={t('weather.eyebrow')} title={t('weather.sectionLabel')} text={t('weather.lead')} />
    <p class="weather-note">{t('weather.note')}</p>
    <div class="weather-grid" data-weather>
      <div class="weather-card weather-card--now" data-weather-now>
        <p class="weather-card__label">{t('weather.today')}</p>
        <div class="weather-now__main">
          <span class="weather-now__icon" data-weather-icon="now" aria-hidden="true"></span>
          <div>
            <span class="weather-now__temp" data-weather-temp="now">--°</span>
            <span class="weather-now__desc" data-weather-desc="now">—</span>
          </div>
        </div>
        <dl class="weather-now__stats">
          <div><dt>{t('weather.now.precip')}</dt><dd data-weather-precip="now">--%</dd></div>
          <div><dt>{t('weather.now.wind')}</dt><dd data-weather-wind="now">-- m/s</dd></div>
          <div><dt>{t('weather.now.humidity')}</dt><dd data-weather-humidity="now">--%</dd></div>
          <div><dt>{t('weather.now.feels')}</dt><dd data-weather-feels="now">--°</dd></div>
        </dl>
      </div>
      <div class="weather-card weather-card--forecast" data-weather-forecast>
        <p class="weather-card__label">{t('weather.forecastLabel')}</p>
        <div class="weather-forecast__list" data-weather-forecast-list>
          <p class="weather-loading">{t('weather.loading')}</p>
        </div>
      </div>
      <div class="weather-card weather-card--advice" data-weather-advice>
        <p class="weather-card__label">{t('weather.tomorrow')}</p>
        <div class="weather-advice__cols">
          <div class="weather-advice__col">
            <p class="weather-advice__col-title">{t('weather.outfit')}</p>
            <ul data-weather-col="outfit"><li class="weather-loading">{t('weather.loading')}</li></ul>
          </div>
          <div class="weather-advice__col">
            <p class="weather-advice__col-title">{t('weather.activities')}</p>
            <ul data-weather-col="activities"><li class="weather-loading">{t('weather.loading')}</li></ul>
          </div>
          <div class="weather-advice__col">
            <p class="weather-advice__col-title">{t('weather.items')}</p>
            <ul data-weather-col="items"><li class="weather-loading">{t('weather.loading')}</li></ul>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script type="application/json" data-wx set:html={JSON.stringify(WX)}></script>
  <script>
    (function () {
      var root = document.querySelector('[data-weather]');
      if (!root) return;
      var WX = JSON.parse(document.querySelector('[data-wx]').textContent);
      var LAT = 33.8416, LON = 132.9356;
      var ICONS = {
        clear: '☀️', clearNight: '🌙', partly: '🌤️', cloudy: '☁️', fog: '🌫️',
        drizzle: '🌦️', rain: '🌧️', heavy: '⛈️', snow: '❄️', thunder: '🌩️'
      };
      function describe(code, isDay) {
        var entry = WX.code[String(code)] || WX.code['default'];
        var label = isDay ? entry.day : (entry.night || entry.day);
        var icon = 'cloudy';
        if (code === 0) icon = isDay ? 'clear' : 'clearNight';
        else if (code === 1) icon = 'partly';
        else if (code === 2) icon = 'partly';
        else if (code === 3) icon = 'cloudy';
        else if (code === 45 || code === 48) icon = 'fog';
        else if (code >= 51 && code <= 57) icon = 'drizzle';
        else if ((code >= 61 && code <= 65) || (code >= 80 && code <= 82)) icon = (code === 65 || code === 82) ? 'heavy' : 'rain';
        else if (code >= 71 && code <= 77) icon = 'snow';
        else if (code === 85 || code === 86) icon = 'snow';
        else if (code >= 95) icon = 'thunder';
        return [icon, label];
      }
      function buildAdvice(current, day, hourly) {
        var advice = [], M = WX.msg, add = function (k) { if (M[k]) advice.push(M[k]); };
        if (current.precip > 0) { add('rainOutfit'); add('rainItems'); add('rainActivities'); }
        if (day.precipProbability >= 40) { add('popItems'); add('popActivities'); }
        if (current.temperature2mMax >= 30 || hourly.some(function (h) { return h.t >= 30; })) { add('hotOutfit'); add('hotActivities'); add('hotItems'); }
        if (current.temperature2mMin != null && current.temperature2mMin <= 5) { add('coldOutfit'); add('coldItems'); }
        if (Math.abs(current.temperature2mMax - current.temperature2mMin) >= 10) { add('diffOutfit'); }
        if (current.uvIndex != null && current.uvIndex >= 6) { add('uvItems'); }
        if (current.precip === 0 && current.cloudCover <= 20) { add('clearOutfit'); add('clearActivities'); }
        else if (current.cloudCover >= 80) { add('cloudyOutfit'); add('cloudyActivities'); }
        if (current.windSpeed10m >= 6) { add('windActivities'); add('windItems'); }
        if (current.windGusts10m >= 12) { add('gustItems'); }
        if (current.weatherCode === 95) { add('thunderRisk'); }
        if (current.precip >= 7.6) { add('heavyRisk'); }
        if (current.windGusts10m >= 12) { add('gustRisk'); }
        if (current.cloudCover >= 95 && current.visibility != null && current.visibility <= 1) { add('fogRisk'); }
        if (!advice.length) { add('defaultOutfit'); add('defaultActivities'); add('defaultItems'); }
        return advice;
      }
      function setText(sel, text) { var el = root.querySelector(sel); if (el) el.textContent = text; }
      function renderNow(current) {
        var pair = describe(current.weatherCode, true);
        setText('[data-weather-icon="now"]', ICONS[pair[0]]);
        setText('[data-weather-temp="now"]', Math.round(current.temperature2m) + '°');
        setText('[data-weather-desc="now"]', pair[1]);
        setText('[data-weather-precip="now"]', Math.round(current.precipProbability) + '%');
        setText('[data-weather-wind="now"]', current.windSpeed10m.toFixed(1) + ' m/s');
        setText('[data-weather-humidity="now"]', Math.round(current.relativeHumidity2m) + '%');
        setText('[data-weather-feels="now"]', Math.round(current.apparentTemperature) + '°');
      }
      function renderForecast(daily) {
        var list = root.querySelector('[data-weather-forecast-list]');
        if (!list) return;
        var html = '';
        for (var i = 0; i < daily.time.length; i++) {
          var pair = describe(daily.weatherCode[i], true);
          var wd = new Date(daily.time[i] + 'T00:00').getDay();
          var label = i === 0 ? WX.today : i === 1 ? WX.tomorrow : WX.weekday[wd];
          html += '<div class="weather-forecast__item">' +
            '<span class="weather-forecast__day">' + label + '</span>' +
            '<span class="weather-forecast__icon">' + ICONS[pair[0]] + '</span>' +
            '<span class="weather-forecast__desc">' + pair[1] + '</span>' +
            '<span class="weather-forecast__temp">' + Math.round(daily.temperature2mMin[i]) + '° / ' + Math.round(daily.temperature2mMax[i]) + '°</span>' +
            '</div>';
        }
        list.innerHTML = html;
      }
      function renderAdvice(current, day, hourly) {
        var advice = buildAdvice(current, day, hourly);
        var map = { outfit: [], activities: [], items: [] };
        advice.forEach(function (m) {
          if (m.indexOf('服装') > -1 || m.indexOf('Clothing') > -1 || m.indexOf('服裝') > -1) map.outfit.push(m);
          else if (m.indexOf('持ち物') > -1 || m.indexOf('What to bring') > -1 || m.indexOf('攜帶物品') > -1) map.items.push(m);
          else map.activities.push(m);
        });
        ['outfit', 'activities', 'items'].forEach(function (col) {
          var ul = root.querySelector('[data-weather-col="' + col + '"]');
          if (!ul) return;
          ul.innerHTML = map[col].map(function (m) { return '<li>' + m + '</li>'; }).join('') || '<li>—</li>';
        });
      }
      function showError() {
        var nodes = root.querySelectorAll('.weather-loading');
        nodes.forEach(function (n) { n.textContent = WX.error || '—'; });
      }
      var url = 'https://api.open-meteo.com/v1/forecast?latitude=' + LAT + '&longitude=' + LON +
        '&current=temperature_2m,relative_humidity_2m,apparent_temperature,precipitation,weather_code,wind_speed_10m,wind_gusts_10m,cloud_cover,visibility,precipitation_probability' +
        '&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,uv_index_max' +
        '&timezone=Asia%2FTokyo&forecast_days=7';
      fetch(url).then(function (r) { return r.json(); }).then(function (data) {
        var cur = data.current, day = { precipProbability: (data.daily.precipitation_probability_max || [0])[0] || 0 };
        var hourly = (data.hourly && data.hourly.temperature_2m ? data.hourly.temperature_2m : []).map(function (t) { return { t: t }; });
        var current = {
          weatherCode: cur.weather_code, temperature2m: cur.temperature_2m,
          temperature2mMax: (data.daily.temperature_2m_max || [cur.temperature_2m])[0],
          temperature2mMin: (data.daily.temperature_2m_min || [cur.temperature_2m])[0],
          precip: cur.precipitation, precipProbability: cur.precipitation_probability,
          windSpeed10m: cur.wind_speed_10m, windGusts10m: cur.wind_gusts_10m,
          cloudCover: cur.cloud_cover, relativeHumidity2m: cur.relative_humidity_2m,
          apparentTemperature: cur.apparent_temperature, visibility: cur.visibility,
          uvIndex: (data.daily.uv_index_max || [null])[0]
        };
        renderNow(current);
        renderForecast(data.daily);
        renderAdvice(current, day, hourly);
      }).catch(showError);
    })();
  </script>
</section>
