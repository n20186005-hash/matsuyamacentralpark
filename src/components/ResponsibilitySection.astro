---
import SectionHeading from './SectionHeading.astro';
import type { Locale } from '../i18n/config';
import { getContent } from '../i18n/content';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale?: Locale;
}
const { locale = 'ja' } = Astro.props;
const t = useTranslations(locale);
const content = getContent(locale);
---
<section class="section section--cream responsibility-section" id="responsibility" aria-labelledby="responsibility-title">
  <div class="container">
    <SectionHeading eyebrow={t('responsibility.eyebrow')} title={t('responsibility.title')} text={content.responsibility.intro} />
    <div class="responsibility-grid">
      {content.responsibility.principles.map((principle, index) => (
        <article class="responsibility-card">
          <span class="responsibility-card__no">{String(index + 1).padStart(2, '0')}</span>
          <h3>{principle.title}</h3>
          <p>{principle.text}</p>
        </article>
      ))}
    </div>
    <div class="responsibility-science">
      <p class="mini-label">{t('responsibility.roleLabel')}</p>
      <p>{content.responsibility.scienceNote}</p>
    </div>
  </div>
</section>
