---
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  label: string;
  locale?: Locale;
}
const { label, locale = 'ja' } = Astro.props;
const t = useTranslations(locale);
---
<span class="photo-credit">{t('common.photoPrefix')}{label}</span>
