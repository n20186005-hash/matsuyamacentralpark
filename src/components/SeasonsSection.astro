---
import SectionHeading from './SectionHeading.astro';
import type { Locale } from '../i18n/config';
import { getContent } from '../i18n/content';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale?: Locale;
}
const { locale = 'ja' } = Astro.props;
const t = useTranslations(locale);
const content = getContent(locale);
---
<section class="section section--cream seasons-section" id="seasons" aria-labelledby="seasons-title">
  <div class="container">
    <SectionHeading eyebrow={t('seasons.eyebrow')} title={t('seasons.title')} text={t('seasons.text')} />
    <div class="seasons-grid">
      {content.seasons.map((season) => (
        <article class="season-card" data-season={season.id}>
          <header class="season-card__head">
            <span class="season-card__name">{season.name}</span>
            <span class="season-card__period">{season.period}</span>
          </header>
          <dl class="season-card__body">
            <div><dt>{t('seasons.label.weather')}</dt><dd>{season.weather}</dd></div>
            <div><dt>{t('seasons.label.bestFor')}</dt><dd>{season.bestFor}</dd></div>
            <div><dt>{t('seasons.label.bring')}</dt><dd>{season.bring}</dd></div>
            <div><dt>{t('seasons.label.nature')}</dt><dd>{season.nature}</dd></div>
          </dl>
        </article>
      ))}
    </div>
    <p class="seasons-note">{t('seasons.note')}</p>
  </div>
</section>
