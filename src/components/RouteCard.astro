---
import Icon from './Icon.astro';
import type { RouteItem } from '../data/site';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  route: RouteItem;
  index: number;
  compact?: boolean;
  locale?: Locale;
}
const { route, index, compact = false, locale = 'ja' } = Astro.props;
const t = useTranslations(locale);
---
<article class:list={['route-card', { 'route-card--compact': compact }]} id={`${route.id}-route`}>
  <div class="route-card__notch route-card__notch--left"></div>
  <div class="route-card__notch route-card__notch--right"></div>
  <header class="route-card__header">
    <span class="route-card__number">{t('common.course')} {String(index + 1).padStart(2, '0')}</span>
    <span class="route-card__icon"><Icon name={route.icon} size={26} /></span>
  </header>
  <h3>{route.name}</h3>
  <p>{route.summary}</p>
  <div class="route-card__meta">
    <span><strong>{route.duration}</strong> {t('common.duration')}</span>
    <span><strong>{route.distance}</strong> {t('common.distance')}</span>
  </div>
  {!compact && (
    <ol class="route-card__stops">
      {route.stops.map((stop, stopIndex) => (
        <li><span>{stopIndex + 1}</span>{stop}</li>
      ))}
    </ol>
  )}
  <p class="route-card__recommendation">{route.recommendation}</p>
</article>
