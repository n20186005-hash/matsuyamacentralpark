---
import SectionHeading from './SectionHeading.astro';
import { getContent } from '../i18n/content';
import { useTranslations } from '../i18n/ui';
import type { Locale } from '../i18n/config';

interface Props {
  locale?: Locale;
}
const { locale = 'ja' } = Astro.props;
const content = getContent(locale);
const t = useTranslations(locale);
---

<section class="section section--cream services-section" id="services" aria-labelledby="services-title">
  <div class="container">
    <SectionHeading
      eyebrow={t('services.eyebrow')}
      title={t('services.title')}
      text={t('services.text')}
    />
    <div class="services-grid">
      {content.visitorServices.map((service, index) => (
        <article class="service-card">
          <header class="service-card__head">
            <span class="service-card__index">{String(index + 1).padStart(2, '0')}</span>
            <h3>{service.title}</h3>
          </header>
          <p class="service-card__lead">{service.lead}</p>
          <ul class="service-card__points">
            {service.points.map((point) => <li>{point}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
