---
import Icon from './Icon.astro';
import type { Facility } from '../data/site';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  facility: Facility;
  variant?: 'image' | 'simple';
  locale?: Locale;
}
const { facility, variant = facility.image ? 'image' : 'simple', locale = 'ja' } = Astro.props;
const t = useTranslations(locale);
const cardClass = ['facility-card', `facility-card--${variant}`];
---
<article class:list={cardClass} id={facility.id}>
  {variant === 'image' && facility.image ? (
    <a class="facility-card__media" href={`/facilities/#${facility.id}`} aria-label={`${facility.name} ${t('common.detail')}`}>
      <img src={facility.image} alt={facility.alt} width="960" height="640" loading="lazy" />
      <span class="facility-card__category">{facility.category}</span>
    </a>
  ) : (
    <div class="facility-card__symbol" aria-hidden="true"><Icon name={facility.icon} size={32} /></div>
  )}
  <div class="facility-card__body">
    {variant === 'simple' && <p class="facility-card__category-text">{facility.category}</p>}
    <h3><a href={`/facilities/#${facility.id}`}>{facility.name}</a></h3>
    <p>{facility.short}</p>
    <dl class="facility-card__facts">
      <div><dt>{t('common.hours')}</dt><dd>{facility.hours}</dd></div>
      <div><dt>{t('common.recommended')}</dt><dd>{facility.bestFor}</dd></div>
    </dl>
    <a class="text-link" href={`/facilities/#${facility.id}`}>
      {t('common.detail')} <Icon name="arrow" size={18} />
    </a>
    <slot />
  </div>
</article>
