---
import Icon from './Icon.astro';
import type { Locale } from '../i18n/config';
import { getContent } from '../i18n/content';
import { useTranslations } from '../i18n/ui';
import { localizePath } from '../i18n/utils';

interface Props {
  heading?: string;
  text?: string;
  locale?: Locale;
}
const { heading, text, locale = 'ja' } = Astro.props;
const t = useTranslations(locale);
const content = getContent(locale);
const firstRoute = content.routes[0]!;
const plannerHeading = heading ?? t('visit.planner.heading');
const plannerText = text ?? t('visit.planner.text');
---
<section class="route-planner" data-route-planner>
  <div class="route-planner__intro">
    <p class="mini-label">{t('common.plannerLabel')}</p>
    <h2>{plannerHeading}</h2>
    <p>{plannerText}</p>
  </div>
  <div class="route-planner__choices" role="group" aria-label={t('common.selectInterest')}>
    {content.routes.map((route, index) => (
      <button type="button" class:list={['route-choice', { 'is-active': index === 0 }]} data-route-id={route.id} aria-pressed={index === 0 ? 'true' : 'false'}>
        <Icon name={route.icon} size={22} />
        <span>{route.name.replace('コース', '')}</span>
      </button>
    ))}
  </div>
  <div class="route-planner__result" aria-live="polite">
    <div class="route-planner__result-top">
      <span class="route-planner__result-icon"><Icon name={firstRoute.icon} size={30} /></span>
      <div>
        <p class="mini-label">{t('common.recommendLabel')}</p>
        <h3 data-route-title>{firstRoute.name}</h3>
      </div>
    </div>
    <p data-route-summary>{firstRoute.summary}</p>
    <dl>
      <div><dt>{t('common.duration')}</dt><dd data-route-duration>{firstRoute.duration}</dd></div>
      <div><dt>{t('common.distance')}</dt><dd data-route-distance>{firstRoute.distance}</dd></div>
      <div><dt>{t('common.bestTime')}</dt><dd data-route-recommendation>{firstRoute.recommendation}</dd></div>
    </dl>
    <a class="button button--dark" href={localizePath('/visit/', locale)} data-route-link>
      {t('common.viewCourse')} <Icon name="arrow" size={18} />
    </a>
  </div>
  <script type="application/json" data-route-data set:html={JSON.stringify(content.routes)}></script>
</section>
