---
import Icon from './Icon.astro';
import type { Locale } from '../i18n/config';
import { getContent } from '../i18n/content';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale?: Locale;
}
const { locale = 'ja' } = Astro.props;
const t = useTranslations(locale);
const content = getContent(locale);
const seo = content.seo;
const landmark1 = seo.nearbyLandmarks[0];
const landmark2 = seo.nearbyLandmarks[1];
const seoVars = {
  name: seo.fullName,
  short: seo.shortName,
  city: seo.city,
  region: seo.region,
  country: seo.country,
  postal: seo.postalCode,
  landmark1,
  landmark2
};
---
<section class="section section--paper seo-entity" aria-label={t('seo.aboutTitle', { name: seo.fullName })}>
  <div class="container seo-entity__inner">
    <div class="seo-entity__copy">
      <h2>{t('seo.aboutTitle', { name: seo.fullName })}</h2>
      <p>{t('seo.about1', seoVars)}</p>
      <p>{t('seo.about2', seoVars)}</p>
      <h2>{t('seo.visitTitle', { name: seo.shortName, city: seo.city })}</h2>
      <p>{t('seo.visit1', seoVars)}</p>
      <p class="seo-breadcrumb">{seo.fullName} → {seo.city} → {seo.region} → {seo.country}</p>
      <h2>{t('seo.landmarkTitle', { name: seo.shortName })}</h2>
      <p>{t('seo.landmark1', seoVars)}</p>
      <h2>{t('seo.historyTitle', { name: seo.fullName })}</h2>
      <p>{t('seo.history1', seoVars)}</p>
    </div>
    <aside class="seo-entity__map">
      <iframe title={t('seo.viewMap')} src={seo.mapsEmbed} width="100%" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
      <p class="seo-entity__gov">
        {t('seo.govText', { country: seo.country, region: seo.region })}{' '}
        <a href={seo.govTourismUrl} target="_blank" rel="noopener noreferrer">{seo.govTourismUrl} <Icon name="arrow" size={16} /></a>.
      </p>
      <a class="button button--outline" href={seo.mapsUrl} target="_blank" rel="noopener noreferrer">
        {t('seo.viewMap')} <Icon name="arrow" size={18} />
      </a>
    </aside>
  </div>
</section>
