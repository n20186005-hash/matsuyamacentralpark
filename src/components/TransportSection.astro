---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { getContent } from '../i18n/content';
import { useTranslations } from '../i18n/ui';
import type { Locale } from '../i18n/config';

interface Props {
  locale?: Locale;
}
const { locale = 'ja' } = Astro.props;
const content = getContent(locale);
const t = useTranslations(locale);
---

<section class="section section--paper transport-section" id="transport" aria-labelledby="transport-title">
  <div class="container">
    <SectionHeading
      eyebrow={t('transport.eyebrow')}
      title={t('transport.title')}
      text={t('transport.text')}
    />
    <div class="transport-grid">
      {content.transport.map((method, index) => (
        <article class="transport-card" id={`transport-${method.id}`}>
          <div class="transport-card__head">
            <span class="transport-card__icon"><Icon name={method.icon} size={30} /></span>
            <div>
              <span class="transport-card__no">{t('access.method.label')} {String(index + 1).padStart(2, '0')}</span>
              <h3>{method.mode}</h3>
            </div>
          </div>
          <p class="transport-card__lead">{method.lead}</p>
          <ol class="transport-card__steps">
            {method.steps.map((step, stepIndex) => (
              <li><span>{stepIndex + 1}</span>{step}</li>
            ))}
          </ol>
        </article>
      ))}
    </div>
  </div>
</section>
