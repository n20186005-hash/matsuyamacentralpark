---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import type { Locale } from '../i18n/config';
import { getContent } from '../i18n/content';
import { useTranslations } from '../i18n/ui';
import { localizePath } from '../i18n/utils';

interface Props {
  locale?: Locale;
}
const { locale = 'ja' } = Astro.props;
const t = useTranslations(locale);
const content = getContent(locale);
const seo = content.seo;
const review = content.googleReview;
const domainUrl = `https://${seo.domain}`;
---
<section class="section section--cream sources-section" id="sources" aria-label={t('sources.sectionLabel')}>
  <div class="container">
    <SectionHeading eyebrow={t('sources.eyebrow')} title={t('sources.title')} text={t('sources.text')} />
    <ul class="sources-list">
      <li class="sources-item">
        <span class="sources-item__tag">{t('sources.tag.review')}</span>
        <div class="sources-item__body">
          <p class="sources-item__lead">{t('sources.review.lead')}</p>
          <p class="sources-item__note">{t('sources.review.note', { month: review.syncMonth })}</p>
          <a class="text-link" href={review.mapsUrl} target="_blank" rel="noopener noreferrer">
            {t('review.button')} <Icon name="arrow" size={16} />
          </a>
        </div>
      </li>
      <li class="sources-item">
        <span class="sources-item__tag">{t('sources.tag.official')}</span>
        <div class="sources-item__body">
          <p class="sources-item__lead">{t('sources.official.lead')}</p>
          <a class="text-link" href={domainUrl}>{domainUrl} <Icon name="arrow" size={16} /></a>
        </div>
      </li>
      <li class="sources-item">
        <span class="sources-item__tag">{t('sources.tag.gov')}</span>
        <div class="sources-item__body">
          <p class="sources-item__lead">{t('sources.gov.lead', { city: seo.city, region: seo.region })}</p>
          <a class="text-link" href={seo.govTourismUrl} target="_blank" rel="noopener noreferrer">
            {seo.govTourismUrl} <Icon name="arrow" size={16} />
          </a>
        </div>
      </li>
      <li class="sources-item">
        <span class="sources-item__tag">{t('sources.tag.photo')}</span>
        <div class="sources-item__body">
          <p class="sources-item__lead">{t('sources.photo.lead')}</p>
          <a class="text-link" href={localizePath('/credits/', locale)}>{t('sources.photo.link')} <Icon name="arrow" size={16} /></a>
        </div>
      </li>
    </ul>
  </div>
</section>
