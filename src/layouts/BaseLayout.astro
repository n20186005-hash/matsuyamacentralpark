---
import '../styles/global.css';
import { getContent } from '../i18n/content';
import { useTranslations } from '../i18n/ui';
import { htmlLang, ogLocale, defaultLocale, type Locale } from '../i18n/config';
import { localizePath } from '../i18n/utils';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
  image?: string;
  bodyClass?: string;
  locale?: Locale;
  availableLocales?: Locale[];
}

const {
  title,
  description: descriptionProp,
  currentPath = Astro.url.pathname,
  image = '/images/og.jpg',
  bodyClass = '',
  locale = 'ja',
  availableLocales
} = Astro.props;

const content = getContent(locale);
const t = useTranslations(locale);
const description = descriptionProp ?? content.site.description;
const available = availableLocales ?? [locale];

const norm = (p: string) => p.replace(/\/$/, '') || '/';
const isActivePath = (href: string) => {
  const b = norm(localizePath(href, locale));
  return href === '/'
    ? norm(currentPath) === b
    : norm(currentPath) === b || norm(currentPath).startsWith(`${b}/`);
};

const pageTitle =
  title === content.site.name
    ? (locale === 'ja'
        ? `${content.site.name}【公式】｜${t('home.title.suffix')}`
        : `${content.site.name} | ${t('home.title.suffix')}`)
    : `${title}｜${content.site.name}`;

const analyticsId = import.meta.env.PUBLIC_GA_ID as string | undefined;
const siteUrl = `https://${content.seo.domain}`;
const canonicalUrl = `${siteUrl}${Astro.url.pathname === '/' ? '/' : Astro.url.pathname}`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'SportsActivityLocation'],
  '@id': `${siteUrl}/#attraction`,
  name: content.seo.fullName,
  alternateName: [content.site.name, `${content.seo.fullName} (${content.seo.city})`, content.seo.shortName],
  description: `Comprehensive visitor guide to ${content.seo.fullName} in ${content.seo.city}, ${content.seo.region}, ${content.seo.country}.`,
  url: siteUrl,
  image: [`${siteUrl}/images/og.jpg`],
  isAccessibleForFree: true,
  telephone: content.site.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Ichitsubo Nishimachi 625-1',
    addressLocality: content.seo.city,
    addressRegion: content.seo.region,
    postalCode: content.seo.postalCode,
    addressCountry: content.seo.countryCode
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: content.seo.latitude,
    longitude: content.seo.longitude
  },
  hasMap: content.seo.mapsUrl,
  sameAs: [content.seo.mapsUrl, content.seo.govTourismUrl],
  amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: '野球場', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'プール', value: true },
    { '@type': 'LocationFeatureSpecification', name: '武道館', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'テニスコート', value: true },
    { '@type': 'LocationFeatureSpecification', name: '駐車場', value: true }
  ]
};
---
<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {available.map((l) => (
      <link rel="alternate" hreflang={l} href={`${siteUrl}${localizePath(currentPath, l)}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${localizePath(currentPath, defaultLocale)}`} />
    <meta name="theme-color" content="#123a63" />
    <meta name="color-scheme" content="light" />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    {analyticsId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}></script>
        <script is:inline define:vars={{ analyticsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', analyticsId);
        </script>
      </>
    )}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">{t('skip.link')}</a>
    <header class="site-header" data-site-header>
      <div class="container site-header__inner">
        <a class="site-header__brand" href={localizePath('/', locale)} aria-label={content.site.name}>
          <Logo />
        </a>
        <nav class="desktop-nav" aria-label={t('nav.main')}>
          {content.navigation.map((item) => (
            <a class:list={{ 'is-active': isActivePath(item.href) }} href={localizePath(item.href, locale)}>{item.label}</a>
          ))}
        </nav>
        <a class="header-access" href={localizePath('/access/', locale)}>
          <Icon name="map-pin" size={19} />
          {t('header.access')}
        </a>
        {available.length > 1 && (
          <LanguageSwitcher locale={locale} available={available} currentPath={currentPath} />
        )}
        <details class="mobile-menu">
          <summary aria-label={t('menu.open')}><span></span><span></span><span></span></summary>
          <nav aria-label={t('nav.mobile')}>
            <a class:list={{ 'is-active': isActivePath('/') }} href={localizePath('/', locale)}>{t('home')}</a>
            {content.navigation.map((item) => <a class:list={{ 'is-active': isActivePath(item.href) }} href={localizePath(item.href, locale)}>{item.label}</a>)}
            <a class:list={{ 'is-active': isActivePath('/credits/') }} href={localizePath('/credits/', locale)}>{t('credits')}</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__grid">
        <div class="site-footer__brand">
          <a href={localizePath('/', locale)}><Logo /></a>
          <p>{content.site.description}</p>
        </div>
        <div>
          <h2>{t('footer.about')}</h2>
          <nav aria-label={t('footer.about')}>
            {content.navigation.map((item) => <a class:list={{ 'is-active': isActivePath(item.href) }} href={localizePath(item.href, locale)}>{item.label}</a>)}
          </nav>
        </div>
        <div>
          <h2>{t('footer.info')}</h2>
          <address>
            <span><Icon name="map-pin" size={18} />{content.site.address}</span>
            <a href={`tel:${content.site.phone.replaceAll('-', '')}`}><Icon name="phone" size={18} />{content.site.phone}</a>
          </address>
          <a class="text-link text-link--light" href={localizePath('/credits/', locale)}>{t('credits')} <Icon name="arrow" size={17} /></a>
        </div>
      </div>
      <div class="container site-footer__bottom">
        <p>{t('footer.copyright')}</p>
        <p>{t('footer.tagline')}</p>
      </div>
    </footer>

    <nav class="mobile-dock" aria-label={t('quicknav')}>
      <a class:list={{ 'is-active': isActivePath('/facilities/') }} href={localizePath('/facilities/', locale)}><Icon name="field" size={20} /><span>{t('dock.facilities')}</span></a>
      <a class:list={{ 'is-active': isActivePath('/visit/') }} href={localizePath('/visit/', locale)}><Icon name="route" size={20} /><span>{t('dock.visit')}</span></a>
      <a class:list={{ 'is-active': isActivePath('/access/') }} href={localizePath('/access/', locale)}><Icon name="map-pin" size={20} /><span>{t('dock.access')}</span></a>
    </nav>
    <script src="/scripts/site.js" defer></script>
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>

<style is:global>
  .lang-switcher {
    position: relative;
  }
  .lang-switcher__toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border: 1px solid color-mix(in srgb, var(--color-text, #fff) 25%, transparent);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    line-height: 1;
  }
  .lang-switcher__menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 140px;
    list-style: none;
    margin: 0;
    padding: 6px;
    border-radius: 12px;
    background: var(--color-white, #fff);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.16);
    display: none;
    z-index: 40;
  }
  .lang-switcher__menu.is-open { display: block; }
  .lang-switcher__item {
    display: block;
    padding: 8px 12px;
    border-radius: 8px;
    color: #1a2b3c;
    text-decoration: none;
  }
  .lang-switcher__item:hover { background: #eef3f8; }
  .lang-switcher__item.is-active { font-weight: 700; color: #123a63; }
  @media (max-width: 980px) {
    .lang-switcher { display: none; }
  }
</style>
